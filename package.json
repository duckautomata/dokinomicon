{
    "name": "dokinomicon",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:mock": "vite --mode mock",
        "dev:mint": "node scripts/sites.mjs dev mint",
        "dev:mint:mock": "node scripts/sites.mjs dev mint --mode mock",
        "build": "node scripts/sites.mjs build",
        "preview": "wrangler dev --ip 127.0.0.1",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "test": "vitest",
        "test:ci": "vitest run --reporter=junit --outputFile=junit.xml"
    },
    "dependencies": {
        "papaparse": "^5.7.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.4",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "jsdom": "^30.1.3",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "wrangler": "^4.151.1"
    }
}
